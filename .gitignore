*.sqlite
*.sqlite3
*.sqlite.fresh
database.sqlite
server/database.sqlite
backend/database.sqlite
*_test_database.sqlite
*_cache_database.sqlite

# ── File Uploads (stored in Supabase Storage in production) ────
uploads/
backend/uploads/


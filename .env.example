# Copy this file to .env and fill in your Supabase project details
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
VITE_USE_EXPRESS_BACKEND=false

# NOTE: service_role key is NOT needed here (no server-side code)
# NEVER add service_role key with VITE_ prefix — it would be exposed in the browser bundle
